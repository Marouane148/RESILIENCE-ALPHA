POSTGRES_DB=resilience
POSTGRES_USER=resilience
POSTGRES_PASSWORD=replace-with-a-local-secret
PAYMENT_API_TOKEN=replace-with-a-long-random-lab-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-secret
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
SESSION_SECRET=replace-with-a-long-random-secret
# Jetons internes (générer des valeurs aléatoires longues, par exemple : openssl rand -hex 24)
REMEDIATOR_TOKEN=replace-with-a-long-random-secret
VAULT_ROOT_TOKEN=replace-with-a-long-random-secret
VAULT_APP_TOKEN=replace-with-a-long-random-secret
# Modèles locaux de l'assistant opérateur (moins de 8 milliards de paramètres)
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Connexion au dashboard : AUTH_MODE=password (défaut) ou webauthn (Face ID, Touch ID, Windows Hello)
AUTH_MODE=password
DASHBOARD_USER=riad
DASHBOARD_PASSWORD=replace-with-a-strong-password
