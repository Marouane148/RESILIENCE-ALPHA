      "type": "timeseries",
      "title": "Requêtes bloquées par le WAF / minute",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "sum(count_over_time({compose_service=\"waf\"} |~ \"(?i)access denied|Inbound Anomaly Score Exceeded\" [1m]))",
          "legendFormat": "blocages WAF",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
